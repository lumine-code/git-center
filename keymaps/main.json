{
  // Part of the `alt-g` family, shared with git-panel (alt-g g), github-panel
  // (alt-g h), git-diff, git-command and open-repository. `s` for switch —
  // `b` selects a branch, `c` opens the centre of the repository context, and
  // `w` selects a worktree. The lock stays in the menu and command palette
  // because another letter says nothing.
  "lumine-workspace": {
    "alt-g b": "git-center:select-branch",
    "alt-g c": "git-center:select-repository",
    "alt-g w": "git-center:select-worktree"
  },

  // The two other ways to open the selected worktree. Locking, moving and
  // removing it stay on the item-actions list, which labels them: they
  // are rare, one is destructive, and every free `alt-<letter>` here would be
  // some other package's reveal key taken for as long as this list has focus.
  ".git-center-worktree-list": {
    "alt-enter": "git-center:open-worktree-in-new-window",
    "shift-enter": "git-center:add-worktree-to-window"
  }
}
