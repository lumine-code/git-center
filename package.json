{
  "name": "git-center",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Show the active Git repository, branch, and working-tree status in the status bar.",
  "keywords": [
    "branch",
    "repository",
    "checkout",
    "upstream",
    "remote",
    "dirty",
    "indicator",
    "vcs"
  ],
  "repository": "https://github.com/lumine-code/git-center",
  "bugs": {
    "url": "https://github.com/lumine-code/git-center/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "consumedServices": {
    "status-bar": {
      "versions": {
        "^1.0.0": "consumeStatusBar"
      }
    }
  },
  "configSchema": {
    "autoLockRepository": {
      "title": "Auto Lock Repository",
      "description": "Lock a repository after selecting it from the repository picker.",
      "type": "boolean",
      "default": false
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
